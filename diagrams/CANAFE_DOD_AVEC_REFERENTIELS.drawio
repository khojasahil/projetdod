        <mxCell id="REF_DISPOSITION" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;REF_DISPOSITION · Utilisation des fonds&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK / FK schema_sha256&lt;br&gt;PK code&lt;br&gt;libelle_fr&lt;br&gt;libelle_en&lt;br&gt;source_pointer&lt;br&gt;libelle_source_pointer&lt;br&gt;&lt;br&gt;Exemples de valeurs :&lt;br&gt;1 = Dépôt au compte&lt;br&gt;3 = Échange en monnaie fiduciare&lt;br&gt;4 = Achat de produits de casino&lt;br&gt;28 valeurs dans le catalogue.&lt;br&gt;&lt;br&gt;Liste complète et source : ouvrir le lien de cette carte.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1" link="https://github.com/khojasahil/projetdod/blob/main/docs/REFERENTIELS_CANAFE.md#ref_disposition">
          <mxGeometry as="geometry" x="1150" y="728" width="990" height="473" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ref-full" name="Modèle complet — tables, colonnes et référentiels">
    <mxGraphModel grid="0" page="0" pageWidth="5320" pageHeight="10050" background="#F3F6FA" connect="1" guides="1">
      <root>
        <mxCell id="0" />
        <mxCell id="report-links" value="À afficher · rattachement au rapport (34 liens)" parent="0" visible="0" />
        <mxCell id="role-links" value="À afficher · fiches des intervenants (6 liens)" parent="0" visible="0" />
        <mxCell id="business-links" value="Relations métier (37 liens)" parent="0" visible="1" />
        <mxCell id="1" value="Tables et mode de lecture" parent="0" visible="1" />
        <mxCell id="title" value="Modèle complet — avec référentiels" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=38;fontStyle=1;fontColor=#142B46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="45" width="3800" height="52" />
        </mxCell>
        <mxCell id="subtitle" value="57 tables · 389 colonnes métier · 77 liens initiaux + 91 liens de référentiels · Une table = un bloc de texte." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="108" width="3800" height="37" />
        </mxCell>
        <mxCell id="note0" value="Commencez par les 37 liens métier affichés. Les autres liens sont accessibles dans Vue &amp;gt; Calques." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="168" width="3800" height="35" />
        </mxCell>
        <mxCell id="note1" value="Le champ str_report_id rattache chaque ligne à STR_REPORT. Ses 34 liens sont masqués au départ pour éviter les longues traversées." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="211" width="3800" height="35" />
        </mxCell>
        <mxCell id="note2" value="Les 6 liens des rôles vers DEFINITION sont également dans un calque séparé. Aucune relation n’a été supprimée." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="254" width="3800" height="35" />
        </mxCell>
        <mxCell id="note3" value="PK = clé primaire · FK = clé étrangère · [REF] = FK vers une liste versionnée · UK* = clé unique de DEFINITION." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="297" width="3800" height="35" />
        </mxCell>
        <mxCell id="note4" value="Les extrémités indiquent 1, zéro ou un (0..1), ou zéro à plusieurs (0..N). R01–R77 renvoient au registre des relations." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="340" width="3800" height="35" />
        </mxCell>
        <mxCell id="note5" value="Neuf domaines métier à gauche; les référentiels CANAFE à droite. Les pages par thème expliquent les liens de codes." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="383" width="3800" height="35" />
        </mxCell>
        <mxCell id="section01" value="&lt;b&gt;01 — Le dossier et les envois&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Une version du rapport peut faire l’objet de plusieurs tentatives d’envoi.&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;align=left;verticalAlign=middle;spacingLeft=25;fillColor=#E3EBF4;strokeColor=none;fontFamily=Arial;fontSize=27;fontColor=#142B46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="520" width="3850" height="92" />
        </mxCell>
        <mxCell id="section02" value="&lt;b&gt;02 — Les personnes et les organisations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;La fiche décrit la personne ou l’entité; les tables de propriété précisent qui la dirige ou la détient.&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;align=left;verticalAlign=middle;spacingLeft=25;fillColor=#E3EBF4;strokeColor=none;fontFamily=Arial;fontSize=27;fontColor=#142B46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="1969" width="3850" height="92" />
        </mxCell>
        <mxCell id="section03" value="&lt;b&gt;03 — Les opérations, les rôles et les comptes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Suivez l’opération, puis l’action, puis les personnes et les comptes qui interviennent.&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;align=left;verticalAlign=middle;spacingLeft=25;fillColor=#E3EBF4;strokeColor=none;fontFamily=Arial;fontSize=27;fontColor=#142B46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="5044" width="3850" height="92" />
        </mxCell>

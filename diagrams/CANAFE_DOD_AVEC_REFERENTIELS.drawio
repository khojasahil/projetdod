<mxfile host="app.diagrams.net" agent="projetdod" version="26.0.0" type="device">
  <diagram id="ref-intro" name="Comprendre les référentiels">
    <mxGraphModel grid="0" page="0" background="#F3F6FA" connect="1" pageWidth="1900" pageHeight="1258">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-size:34px;line-height:42px;color:#142B46;font-weight:bold&quot;&gt;Comprendre les référentiels&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:29px&quot;&gt;Le rapport garde le code. Le référentiel explique ce code et rattache sa signification au Swagger utilisé.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=#F3F6FA;strokeColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1780" height="121" />
        </mxCell>
        <mxCell id="account" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#059669;font-weight:bold&quot;&gt;Le compte déclaré&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;STR_ACCOUNT — extrait&lt;br&gt;PK account_id&lt;br&gt;FK schema_sha256&lt;br&gt;FK type_code = 1&lt;br&gt;&lt;br&gt;Le compte contient la valeur 1.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="205" width="580" height="249" />
        </mxCell>
        <mxCell id="ref" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;La liste qui explique le code&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;REF_TYPE_COMPTE&lt;br&gt;PK schema_sha256 + code&lt;br&gt;&lt;br&gt;1 = Personnel&lt;br&gt;2 = Commercial&lt;br&gt;3 = En fiducie&lt;br&gt;4 = Autre&lt;br&gt;5 = Casino&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="205" width="770" height="305" />
        </mxCell>
        <mxCell id="e1" value="type_code → code" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;fontFamily=Arial;labelBackgroundColor=#F3F6FA;" edge="1" parent="1" source="account" target="ref">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="845.0" y="329.5" />
              <mxPoint x="845.0" y="357.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="why" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#2563EB;font-weight:bold&quot;&gt;Ce que cela change pour nous&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;Nous savons quelles valeurs proposer à la saisie et comment les expliquer.&lt;br&gt;Une valeur absente de la liste est repérée avant la transmission.&lt;br&gt;Le code transmis à CANAFE reste identique; les libellés servent à notre lecture.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="580" width="1740" height="165" />
        </mxCell>
        <mxCell id="limits" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#B7791F;font-weight:bold&quot;&gt;La liste ne décide pas de tout&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;Un code peut exister sans être permis pour un rôle donné. Exemple : un bénéficiaire utilise une fiche de type 3 ou 4.&lt;br&gt;Les dates, les montants et les textes ont des règles de format. Nous ne créons pas une table de référence pour chacun.&lt;br&gt;Les réponses reçues sont conservées même si elles contiennent un code encore inconnu.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="790" width="1740" height="165" />
        </mxCell>
        <mxCell id="reading" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;Comment lire ce fichier&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;34 tables métier conservées + 22 tables de codes + REF_SCHEMA_VERSION.&lt;br&gt;Commencez ici, puis regardez la page « Version du Swagger et clés ».&lt;br&gt;Les pages par thème montrent les champs codifiés. La dernière page contient toutes les tables et colonnes.&lt;br&gt;Un bloc = une table ou un extrait. Double-cliquez pour modifier les lignes comme dans un document.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1000" width="1740" height="193" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ref-version" name="Version du Swagger et clés">
    <mxGraphModel grid="0" page="0" background="#F3F6FA" connect="1" pageWidth="1900" pageHeight="1556">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-size:34px;line-height:42px;color:#142B46;font-weight:bold&quot;&gt;Version du Swagger et clés&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:29px&quot;&gt;Une correction future du catalogue ne doit pas changer la lecture d’une ancienne déclaration.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=#F3F6FA;strokeColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="1780" height="121" />
        </mxCell>
        <mxCell id="report" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#2563EB;font-weight:bold&quot;&gt;STR_REPORT — version du rapport&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK str_report_id&lt;br&gt;FK schema_sha256&lt;br&gt;version_number&lt;br&gt;report_type_code = 102&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="210" width="650" height="193" />
        </mxCell>
        <mxCell id="schema" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;REF_SCHEMA_VERSION&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK schema_sha256&lt;br&gt;openapi_version&lt;br&gt;api_version&lt;br&gt;archived_on&lt;br&gt;source_url&lt;br&gt;archive_path&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1100" y="210" width="720" height="249" />
        </mxCell>
        <mxCell id="a" value="version utilisée" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;fontFamily=Arial;labelBackgroundColor=#F3F6FA;" edge="1" parent="1" source="report" target="schema">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="905.0" y="306.5" />
              <mxPoint x="905.0" y="334.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="account" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#059669;font-weight:bold&quot;&gt;STR_ACCOUNT — extrait&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK account_id&lt;br&gt;FK str_report_id&lt;br&gt;FK schema_sha256 [ajout]&lt;br&gt;FK type_code&lt;br&gt;&lt;br&gt;Même empreinte que le rapport parent.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#059669;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="630" width="650" height="249" />
        </mxCell>
        <mxCell id="codes" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;REF_TYPE_COMPTE&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK / FK schema_sha256&lt;br&gt;PK code&lt;br&gt;libelle_fr&lt;br&gt;libelle_en&lt;br&gt;source_pointer&lt;br&gt;libelle_source_pointer&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1100" y="630" width="720" height="249" />
        </mxCell>
        <mxCell id="b" value="(schema_sha256, type_code)" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;fontFamily=Arial;labelBackgroundColor=#F3F6FA;" edge="1" parent="1" source="account" target="codes">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="905.0" y="754.5" />
              <mxPoint x="905.0" y="754.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rules" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;Les clés, en langage simple&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;Chaque liste est conservée avec la copie exacte du Swagger dont elle provient.&lt;br&gt;La référence du compte porte sur deux champs : la version du Swagger et le code. Le code seul ne suffit pas.&lt;br&gt;Chaque table métier enrichie garde la même empreinte que son rapport : FK (str_report_id, schema_sha256) vers STR_REPORT.&lt;br&gt;Dans le rapport, le couple (str_report_id, schema_sha256) est une clé unique. Les codes sont validés avant le gel.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1060" width="1760" height="193" />
        </mxCell>
        <mxCell id="idnote" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#B7791F;font-weight:bold&quot;&gt;Attention aux documents d’identification&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;Pour une personne : code 1 = certificat de naissance. Pour une entité : code 1 = acte d’association.&lt;br&gt;REF_TYPE_IDENTIFICATION utilise donc la clé (schema_sha256, identification_family, code).&lt;br&gt;La nouvelle colonne identification_family vaut PERSON ou ENTITY selon la définition propriétaire. Elle ne part pas dans le JSON.&lt;br&gt;Cette cohérence est une règle métier à contrôler avec STR_DEFINITION; une FK de catalogue ne la prouve pas à elle seule.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1298" width="1760" height="193" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ref-domain-0" name="Rapport — champs et listes">
    <mxGraphModel grid="0" page="0" background="#F3F6FA" connect="1" pageWidth="2300" pageHeight="3807">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;div style=&quot;font-size:34px;line-height:42px;color:#142B46;font-weight:bold&quot;&gt;Rapport — champs et listes&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:21px;line-height:29px&quot;&gt;Extraits de tables. Une table peut réapparaître pour expliquer un autre champ. Toutes les colonnes sont dans la dernière page.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=#F3F6FA;strokeColor=none;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="35" width="2180" height="121" />
        </mxCell>
        <mxCell id="ref0" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;REF_TYPE_RAPPORT · Type de déclaration&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK / FK schema_sha256&lt;br&gt;PK code&lt;br&gt;libelle_fr&lt;br&gt;libelle_en&lt;br&gt;source_pointer&lt;br&gt;libelle_source_pointer&lt;br&gt;&lt;br&gt;Exemples de valeurs :&lt;br&gt;14 = Déclaration d&amp;#x27;opérations importantes en monnaie virtuelle (DOIMV)&lt;br&gt;102 = Décl. d&amp;#x27;opérations douteuses (DOD)&lt;br&gt;106 = Décl. d&amp;#x27;opér. importantes en esp. (DOIE)&lt;br&gt;5 valeurs dans le catalogue.&lt;br&gt;&lt;br&gt;La liste officielle couvre plusieurs déclarations. Ici, le rapport DOD utilise uniquement&lt;br&gt;le code 102.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="205" width="790" height="501" />
        </mxCell>
        <mxCell id="s0-0" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#2563EB;font-weight:bold&quot;&gt;STR_REPORT · Le rapport&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK str_report_id&lt;br&gt;FK schema_sha256&lt;br&gt;FK report_type_code&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="205" width="960" height="165" />
        </mxCell>
        <mxCell id="e0-0" value="code + version" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;fontFamily=Arial;labelBackgroundColor=#F3F6FA;" edge="1" parent="1" source="s0-0" target="ref0">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1225.0" y="287.5" />
              <mxPoint x="1225.0" y="455.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ref1" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;REF_TYPE_SOUMISSION · Nature de la demande&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK / FK schema_sha256&lt;br&gt;PK code&lt;br&gt;libelle_fr&lt;br&gt;libelle_en&lt;br&gt;source_pointer&lt;br&gt;libelle_source_pointer&lt;br&gt;&lt;br&gt;Exemples de valeurs :&lt;br&gt;1 = Soumettre&lt;br&gt;2 = Mise à jour&lt;br&gt;5 = Supprimer&lt;br&gt;3 valeurs dans le catalogue.&lt;br&gt;&lt;br&gt;La demande et le point de terminaison doivent correspondre : 1 = soumettre, 2 =&lt;br&gt;mettre à jour, 5 = supprimer.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="781" width="790" height="501" />
        </mxCell>
        <mxCell id="s1-0" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#2563EB;font-weight:bold&quot;&gt;STR_REPORT · Le rapport&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK str_report_id&lt;br&gt;FK schema_sha256&lt;br&gt;FK submit_type_code&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="781" width="960" height="165" />
        </mxCell>
        <mxCell id="e1-0" value="code + version" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;fontFamily=Arial;labelBackgroundColor=#F3F6FA;" edge="1" parent="1" source="s1-0" target="ref1">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1225.0" y="863.5" />
              <mxPoint x="1225.0" y="1031.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ref2" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#0369A1;font-weight:bold&quot;&gt;REF_SECTEUR_ACTIVITE · Secteur du déclarant&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK / FK schema_sha256&lt;br&gt;PK code&lt;br&gt;libelle_fr&lt;br&gt;libelle_en&lt;br&gt;source_pointer&lt;br&gt;libelle_source_pointer&lt;br&gt;&lt;br&gt;Exemples de valeurs :&lt;br&gt;1 = Comptable&lt;br&gt;2 = Banque&lt;br&gt;3 = Caisse populaire&lt;br&gt;25 valeurs dans le catalogue.&lt;br&gt;&lt;br&gt;Cette liste explique le code. La présence obligatoire du champ et les conditions&lt;br&gt;métier se vérifient séparément.&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#0369A1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="1357" width="790" height="501" />
        </mxCell>
        <mxCell id="s2-0" value="&lt;div style=&quot;font-size:23px;line-height:31px;color:#2563EB;font-weight:bold&quot;&gt;STR_REPORT · Le rapport&lt;/div&gt;&lt;div style=&quot;height:14px&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:20px;line-height:28px&quot;&gt;PK str_report_id&lt;br&gt;FK schema_sha256&lt;br&gt;FK activity_sector_code&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;spacingTop=18;spacingLeft=20;spacingRight=20;fontFamily=Arial;fontColor=#142B46;fillColor=white;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1357" width="960" height="165" />
        </mxCell>
        <mxCell id="e2-0" value="code + version" style="edgeStyle=none;rounded=0;html=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;endSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=17;fontFamily=Arial;labelBackgroundColor=#F3F6FA;" edge="1" parent="1" source="s2-0" target="ref2">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1225.0" y="1439.5" />
              <mxPoint x="1225.0" y="1607.5" />
            </Array>

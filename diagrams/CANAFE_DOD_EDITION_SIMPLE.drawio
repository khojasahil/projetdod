        </mxCell>
        <mxCell id="section02" value="&lt;b&gt;02 — Les personnes et les organisations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;La fiche décrit la personne ou l’entité; les tables de propriété précisent qui la dirige ou la détient.&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;align=left;verticalAlign=middle;spacingLeft=25;fillColor=#E3EBF4;strokeColor=none;fontFamily=Arial;fontSize=27;fontColor=#142B46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="1721" width="2930" height="92" />
        </mxCell>
        <mxCell id="section03" value="&lt;b&gt;03 — Les opérations, les rôles et les comptes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Suivez l’opération, puis l’action, puis les personnes et les comptes qui interviennent.&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;align=left;verticalAlign=middle;spacingLeft=25;fillColor=#E3EBF4;strokeColor=none;fontFamily=Arial;fontSize=27;fontColor=#142B46;" vertex="1" parent="1">

          <mxGeometry as="geometry" x="2290" y="705" width="2000" height="37" />
        </mxCell>
        <mxCell id="zone-question-1" value="&lt;div style=&quot;line-height:26px&quot;&gt;De qui parle-t-on ?&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#24364B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2290" y="755" width="2000" height="26" />
        </mxCell>
        <mxCell id="STR_DEFINITION" value="&lt;div style=&quot;font-size:23px;color:#142B46;font-weight:bold;line-height:30px;margin:0 0 7px 0;&quot;&gt;Le point de référence&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#15803D;font-weight:bold;line-height:23px;margin:0 0 18px 0;&quot;&gt;STR_DEFINITION&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:30px;&quot;&gt;&lt;b&gt;definition_id : Identifiant [PK]&lt;/b&gt;&lt;br&gt;str_report_id : Identifiant [FK]&lt;br&gt;ordinal : Entier&lt;br&gt;type_code : Entier&lt;br&gt;ref_id : Texte&lt;/div&gt;&lt;div style=&quot;height:12px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-size:16px;color:#15803D;font-weight:bold;line-height:23px;margin:0 0 14px 0;&quot;&gt;Références · lignes de cette table par parent&lt;/div&gt;&lt;div style=&quot;color:#5E7185;&quot;&gt;&lt;div style=&quot;font-size:16px;line-height:32px;&quot;&gt;str_report_id → REPORT.str_report_id | 0..N&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D8E2EC;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=17;spacingLeft=22;spacingRight=18;spacingBottom=15;fontFamily=Arial;fontSize=17;fontColor=#24364B;strokeColor=#15803D;strokeWidth=2;" vertex="1" parent="1">

        <mxCell id="footer0" value="À retenir pour expliquer le modèle" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="7767" width="3800" height="35" />
        </mxCell>
        <mxCell id="footer1" value="DEFINITION : UK* désigne ensemble (str_report_id, type_code, ref_id). Aucune de ces colonnes n’est unique à elle seule." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="7807" width="3800" height="35" />
        </mxCell>
        <mxCell id="footer2" value="Les liens vers un sous-objet restent dans la même version du rapport. Une correction crée une nouvelle version; un nouvel essai crée un envoi." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="7847" width="3800" height="35" />
        </mxCell>
        <mxCell id="footer3" value="ACCOUNT et VC_DATA : renseigner une seule action, initiale ou finale. Les deux FK facultatives représentent cette alternative." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="7887" width="3800" height="35" />
        </mxCell>
        <mxCell id="footer4" value="Une ligne de champ suffit pour modifier une table. Les connecteurs restent attachés aux clés; le registre précise les clés composites." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="7927" width="3800" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page12" name="Relations — PK et FK seulement">
    <mxGraphModel grid="0" page="0" pageWidth="3080" pageHeight="6029" background="#F3F6FA" connect="1" guides="1">
      <root>
        <mxCell id="0" />
        <mxCell id="report-links" value="À afficher · rattachement au rapport (34 liens)" parent="0" visible="0" />
        <mxCell id="role-links" value="À afficher · fiches des intervenants (6 liens)" parent="0" visible="0" />
        <mxCell id="business-links" value="Relations métier (37 liens)" parent="0" visible="1" />
        <mxCell id="1" value="Tables et mode de lecture" parent="0" visible="1" />
        <mxCell id="title" value="Relations — PK et FK seulement" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=38;fontStyle=1;fontColor=#142B46;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="45" width="2880" height="52" />
        </mxCell>
        <mxCell id="subtitle" value="34 tables · 119 champs de clés · 77 relations disponibles · Une table = un bloc de texte." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=23;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="108" width="2880" height="37" />
        </mxCell>
        <mxCell id="note0" value="Commencez par les 37 liens métier affichés. Les deux autres familles de liens sont accessibles dans Vue &amp;gt; Calques." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="168" width="2880" height="35" />
        </mxCell>
        <mxCell id="note1" value="Le champ str_report_id rattache chaque ligne à STR_REPORT. Ses 34 liens sont masqués au départ pour éviter les longues traversées." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="211" width="2880" height="35" />
        </mxCell>
        <mxCell id="note2" value="Les 6 liens des rôles vers DEFINITION sont également dans un calque séparé. Aucune relation n’a été supprimée." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="254" width="2880" height="35" />
        </mxCell>
        <mxCell id="note3" value="PK = clé primaire · FK = clé étrangère · UK* = composant de la clé unique référencée de DEFINITION." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="297" width="2880" height="35" />
        </mxCell>
        <mxCell id="note4" value="Les extrémités indiquent 1, zéro ou un (0..1), ou zéro à plusieurs (0..N). R01–R77 renvoient au registre des relations." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="340" width="2880" height="35" />
        </mxCell>
        <mxCell id="note5" value="Les couleurs identifient les neuf domaines. Parcourez les trois sections de haut en bas, puis les tables de gauche à droite." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=0;fontColor=#24364B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="383" width="2880" height="35" />
        </mxCell>
        <mxCell id="section01" value="&lt;b&gt;01 — Le dossier et les envois&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:20px&quot;&gt;Une version du rapport peut faire l’objet de plusieurs tentatives d’envoi.&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;align=left;verticalAlign=middle;spacingLeft=25;fillColor=#E3EBF4;strokeColor=none;fontFamily=Arial;fontSize=27;fontColor=#142B46;" vertex="1" parent="1">

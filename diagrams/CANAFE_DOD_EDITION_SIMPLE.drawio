        </mxCell>
        <mxCell id="reading-note" value="" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="1660" width="1480" height="345" />
        </mxCell>
        <mxCell id="note-title0" value="La fiche et le rôle sont deux choses différentes." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1680" width="1410" height="36" />
        </mxCell>
        <mxCell id="note-body0" value="On décrit une personne une fois dans Définitions. Elle peut ensuite avoir plusieurs rôles dans les opérations." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#506378;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1711" width="1410" height="33" />
        </mxCell>
        <mxCell id="note-title1" value="Une correction et un nouvel essai d’envoi sont différents." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1759" width="1410" height="36" />
        </mxCell>
        <mxCell id="note-body1" value="Le rapport porte la version. Audit conserve les tentatives d’envoi et les réponses reçues." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#506378;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1790" width="1410" height="33" />
        </mxCell>
        <mxCell id="note-title2" value="Cette page montre le chemin, pas toutes les clés." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1838" width="1410" height="36" />
        </mxCell>
        <mxCell id="note-body2" value="Les flèches entre domaines guident la lecture. Les liens entre tables sont une sélection du modèle." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#506378;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1869" width="1410" height="33" />
        </mxCell>
        <mxCell id="note-title3" value="Pour passer au détail" style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=22;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1917" width="1410" height="36" />
        </mxCell>
        <mxCell id="note-body3" value="Page 13 : les PK/FK et les cardinalités. Page 12 : toutes les colonnes. Les 77 relations y sont disponibles." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#506378;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="945" y="1948" width="1410" height="33" />
        </mxCell>
        <mxCell id="foot" value="Lecture : partir du rapport, puis suivre les branches. Le trait violet pointillé rappelle que les rôles réutilisent les fiches." style="text;html=1;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#506378;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2050" width="2340" height="35" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

        <mxCell id="domain-note-8-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;Une tentative d’envoi n’est pas une nouvelle version&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">

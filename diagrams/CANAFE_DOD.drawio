        <mxCell id="kicker" value="&lt;div style=&quot;line-height:21px&quot;&gt;CANAFE / DOD–STR / MODÈLE DE DONNÉES&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=14;fontColor=#5E7185;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="28" width="1300" height="21" />
        </mxCell>
        <mxCell id="title" value="&lt;div style=&quot;line-height:43px&quot;&gt;Le modèle complet — domaines, tables et colonnes&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=36;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="64" width="1480" height="43" />
        </mxCell>
        <mxCell id="subtitle" value="&lt;div style=&quot;line-height:26px&quot;&gt;34 tables · 365 colonnes · 77 références documentées · Une seule page à parcourir en zoomant.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#5E7185;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="114" width="1480" height="26" />
        </mxCell>
        <mxCell id="footer" value="&lt;div style=&quot;line-height:20px&quot;&gt;PROJET DOD • Architecture reprise de projet-io | 10&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=13;fontColor=#5E7185;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="7413" width="1480" height="20" />
        </mxCell>
        <mxCell id="read" value="" style="rounded=1;arcSize=8;fillColor=#EAF0F7;strokeColor=#EAF0F7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="185" width="2080" height="185" />
        </mxCell>
        <mxCell id="read-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;Comment parcourir cette page&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="92" y="203" width="2036" height="28" />
        </mxCell>
        <mxCell id="read-b" value="&lt;div style=&quot;line-height:25px&quot;&gt;À gauche : le rapport, les opérations et les comptes. Au centre : les fiches, les rôles et les envois. À droite : l’identité, l’entité et sa propriété. Chaque domaine garde sa couleur et ses noms de tables.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#24364B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="92" y="239" width="2036" height="25" />
        </mxCell>
        <mxCell id="keys" value="" style="rounded=1;arcSize=8;fillColor=#EAF0F7;strokeColor=#EAF0F7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2250" y="185" width="2080" height="185" />
        </mxCell>
        <mxCell id="keys-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;Les repères à connaître&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2272" y="203" width="2036" height="28" />
        </mxCell>
        <mxCell id="keys-b" value="&lt;div style=&quot;line-height:25px&quot;&gt;PK identifie une ligne. FK retrouve une ligne liée. Sous chaque table, les références indiquent la clé et la table visée. Le nombre après | se lit depuis le parent : 0..1 ou 0..N lignes de la table courante.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#24364B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2272" y="239" width="2036" height="25" />
        </mxCell>
        <mxCell id="history" value="" style="rounded=1;arcSize=8;fillColor=#EAF0F7;strokeColor=#EAF0F7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="4430" y="185" width="2080" height="185" />
        </mxCell>
        <mxCell id="history-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;Le rapport reste le fil conducteur&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="4452" y="203" width="2036" height="28" />
        </mxCell>
        <mxCell id="history-b" value="&lt;div style=&quot;line-height:25px&quot;&gt;Chaque table porte str_report_id : tous ses renseignements appartiennent à une version précise. Les références vers les autres tables sont toujours contrôlées dans cette même version.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#24364B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="4452" y="239" width="2036" height="25" />
        </mxCell>
        <mxCell id="complete-links" value="" style="rounded=1;arcSize=8;fillColor=#EAF0F7;strokeColor=#EAF0F7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="410" width="3170" height="175" />
        </mxCell>
        <mxCell id="complete-links-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;Retrouver les liens sans perdre le fil&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="92" y="428" width="3126" height="28" />
        </mxCell>
        <mxCell id="complete-links-b" value="&lt;div style=&quot;line-height:25px&quot;&gt;Les flèches montrent les liens de structure au sein des domaines. Les 77 références, y compris les liens entre domaines et vers REPORT, sont écrites au bas des cartes. STR_ est omis dans ces références pour alléger la lecture.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#24364B;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="92" y="464" width="3126" height="25" />
        </mxCell>
        <mxCell id="reading-codes" value="" style="rounded=1;arcSize=8;fillColor=#EAF0F7;strokeColor=#EAF0F7;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3340" y="410" width="3170" height="175" />
        </mxCell>
        <mxCell id="reading-codes-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;Lire les champs avec leur contexte&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">

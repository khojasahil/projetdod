        <mxCell id="domain-note-1-t" value="&lt;div style=&quot;line-height:28px&quot;&gt;La fiche et son usage sont deux choses différentes&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#142B46;fontStyle=1;" vertex="1" parent="1">
